CREATE DATABASE hostel_management;
USE hostel_management;

CREATE TABLE students (
    student_id   INT AUTO_INCREMENT PRIMARY KEY,
    email        VARCHAR(100) NOT NULL UNIQUE,
    name         VARCHAR(100) NOT NULL,
    phone        VARCHAR(15)  NOT NULL UNIQUE,
    gender       VARCHAR(20)  NOT NULL,
    course       VARCHAR(50)  NOT NULL,
    year         VARCHAR(50)  NOT NULL,
    password     VARCHAR(255) NOT NULL,
    created_at   DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE rooms (
    room_number  VARCHAR(20) PRIMARY KEY,
    floor        INT NOT NULL,
    capacity     INT NOT NULL,
    status       VARCHAR(50),
    created_at   DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at   DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE allocations (
    allocation_id    INT AUTO_INCREMENT PRIMARY KEY,
    student_id       INT NOT NULL,
    room_number      VARCHAR(20) NOT NULL,
    bed_number       VARCHAR(20) NOT NULL,
    allocation_date  DATE NOT NULL,
    reason           TEXT,
    status           VARCHAR(50) NOT NULL DEFAULT 'active',
    created_at       DATETIME DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_alloc_student FOREIGN KEY (student_id)
        REFERENCES students(student_id) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_alloc_room FOREIGN KEY (room_number)
        REFERENCES rooms(room_number) ON DELETE RESTRICT ON UPDATE CASCADE,

    UNIQUE KEY uq_room_bed (room_number, bed_number)
);

CREATE TABLE fees (
    fee_id       INT AUTO_INCREMENT PRIMARY KEY,
    student_id   INT NOT NULL,
    room_number  VARCHAR(20) NOT NULL,
    total_fee    DECIMAL(10,2) NOT NULL,
    paid         DECIMAL(10,2) NOT NULL DEFAULT 0,
    due          DECIMAL(10,2) NOT NULL DEFAULT 0,
    status       VARCHAR(50) NOT NULL DEFAULT 'pending',
    created_at   DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at   DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_fees_student FOREIGN KEY (student_id)
        REFERENCES students(student_id) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_fees_room FOREIGN KEY (room_number)
        REFERENCES rooms(room_number) ON DELETE RESTRICT ON UPDATE CASCADE
);

CREATE TABLE payment_history (
    student_id      INT NOT NULL,
    fee_id          INT,
    date            DATE NOT NULL,
    amount          DECIMAL(10,2) NOT NULL,
    method          VARCHAR(50) NOT NULL,
    transaction_id  VARCHAR(100) NOT NULL UNIQUE,
    created_at      DATETIME DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_payment_student FOREIGN KEY (student_id)
        REFERENCES students(student_id) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_payment_fee FOREIGN KEY (fee_id)
        REFERENCES fees(fee_id) ON DELETE SET NULL ON UPDATE CASCADE
);

CREATE TABLE complaints (
    complaint_no  INT AUTO_INCREMENT primary key,
    student_id    INT NOT NULL,
    room_number   VARCHAR(20) NOT NULL,
    category      VARCHAR(50) NOT NULL,
    submitted     DATE NOT NULL,
    description   TEXT NOT NULL,
    status        VARCHAR(50) NOT NULL,
    remarks       TEXT,
    created_at    DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at    DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_complaint_student FOREIGN KEY (student_id)
        REFERENCES students(student_id) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_complaint_room FOREIGN KEY (room_number)
        REFERENCES rooms(room_number) ON DELETE RESTRICT ON UPDATE CASCADE
);

CREATE TABLE leaves (
    leave_no     INT AUTO_INCREMENT primary key,
    student_id   INT NOT NULL,
    room_number  VARCHAR(20) NOT NULL,
    type         VARCHAR(50) NOT NULL,
    from_date    DATE NOT NULL,
    to_date      DATE NOT NULL,
    reason       TEXT,
    status       VARCHAR(50),
    created_at   DATETIME DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_leave_student FOREIGN KEY (student_id)
        REFERENCES students(student_id) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_leave_room FOREIGN KEY (room_number)
        REFERENCES rooms(room_number) ON DELETE RESTRICT ON UPDATE CASCADE,

    CHECK (to_date >= from_date)
);

CREATE TABLE notices (
    notice_id     INT AUTO_INCREMENT PRIMARY KEY,
    title         VARCHAR(255) NOT NULL,
    category      VARCHAR(50) NOT NULL,
    start_date  DATE NOT NULL,
    end_date  DATE NOT NULL,
    description   TEXT,
    status        VARCHAR(50),
    created_at    DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE admin (
    username     VARCHAR(25) NOT NULL UNIQUE,
    password     VARCHAR(255) NOT NULL
);

